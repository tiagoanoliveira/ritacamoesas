{
  "name": "rita-camoesas-atelier",
  "version": "1.0.0",
  "private": true,
  "description": "Website da Rita Camoesas e do Atelier by Rita",
  "scripts": {
    "copy:fonts": "node ./scripts/copy-fonts.mjs",
    "dev:css": "npm run copy:fonts && tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --watch",
    "build:css": "npm run copy:fonts && tailwindcss -i ./src/tailwind.css -o ./public/css/tailwind.css --minify",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=20"
  }
}
